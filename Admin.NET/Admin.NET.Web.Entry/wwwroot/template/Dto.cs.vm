using Admin.NET.Core;
@foreach (var entityNamespace in (model is CodeGenRenderModel generatedModel ? generatedModel.EntityNamespaces : new[] { model.EntityNamespace ?? model.NameSpace + ".Entity" })) { @:using @(entityNamespace);
}
namespace @(model.NameSpace);

/// <summary>
/// @(CodeGenTemplateSupport.Comment(model.BusName))输出参数
/// </summary>
public class @(model.ClassName)Dto
{
@foreach (var column in model.TableField){
if(column.EffectType == "ForeignKey"){
    @:/// <summary>
    @:/// @(CodeGenTemplateSupport.Comment(column.ColumnComment))
    @:/// </summary>
    @:public string @(column.PropertyName)FkColumn { get; set; }
    @:
}
}
@foreach (var column in model.TableField){
    @:/// <summary>
    @:/// @(CodeGenTemplateSupport.Comment(column.ColumnComment))
    @:/// </summary>
    @:public @column.NetType @column.PropertyName { get; set; }
    @:
}
}
