@{ var model = (Admin.NET.Core.Service.CustomViewEngine)Model; }
<script setup lang="ts">
import type { GeneratedRow } from '#/components/admin/generated';
import { ref } from 'vue';
import { api, schema } from '#/api/@(model.PagePath)/@(model.LowerClassName)';
import GeneratedEditor from '#/components/admin/generated-editor.vue';

const emit = defineEmits<{ saved: [] }>();
const editor = ref<InstanceType<typeof GeneratedEditor>>();
defineExpose({ show: (row?: GeneratedRow) => editor.value?.show(row), close: () => editor.value?.close() });
</script>

<template>
 <GeneratedEditor ref="editor" :api="api" :schema="schema" @@saved="emit('saved')" />
</template>
