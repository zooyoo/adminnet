@{ var model = (Admin.NET.Core.Service.CustomViewEngine)Model; }
<script setup lang="ts">
import { ref } from 'vue';
import { api, schema } from '#/api/@(model.PagePath)/@(model.LowerClassName)';
import GeneratedPage from '#/components/admin/generated-page.vue';
import EditDialog from './component/editDialog.vue';

defineOptions({ name: '@(model.ClassName)' });
const page = ref<InstanceType<typeof GeneratedPage>>();
const editor = ref<InstanceType<typeof EditDialog>>();
</script>

<template>
 <GeneratedPage ref="page" :api="api" :schema="schema" @@edit="editor?.show($event)" @@deactivate="editor?.close()" />
 <EditDialog ref="editor" @@saved="page?.reload()" />
</template>
