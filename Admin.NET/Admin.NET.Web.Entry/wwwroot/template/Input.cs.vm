@using Admin.NET.Core.Service
@{
    var model = (Admin.NET.Core.Service.CustomViewEngine)Model;
    System.Func<string, string> literal = Admin.NET.Core.Service.CodeGenTemplateSupport.Literal;
    System.Func<string, string> comment = Admin.NET.Core.Service.CodeGenTemplateSupport.Comment;
    System.Func<string, string> nullable = Admin.NET.Core.Service.CodeGenTemplateSupport.NullableType;
    var editable = model.PrimaryKeyFieldList.Concat(model.AddUpdateFieldList).DistinctBy(field => field.PropertyName).GroupBy(field => field.PropertyName).Select(group => group.First()).ToList();
}
// Admin.NET 项目的版权、商标、专利和其他相关权利均受相应法律法规的保护。使用本项目应遵守相关法律法规和许可证的要求。
