using Admin.NET.Core;
using System.ComponentModel.DataAnnotations;
using Magicodes.ExporterAndImporter.Core;
using Magicodes.ExporterAndImporter.Excel;

@foreach (var entityNamespace in (model is CodeGenRenderModel generatedModel ? generatedModel.EntityNamespaces : new[] { model.EntityNamespace ?? model.NameSpace + ".Entity" })) { @:using @(entityNamespace);
}
namespace @(model.NameSpace);

/// <summary>
/// @(comment(model.BusName))基础输入参数
/// </summary>
public class @(model.ClassName)BaseInput
{
@foreach (var column in editable) {
    @:/// <summary>
    @:/// @(comment(column.ColumnComment))
    @:/// </summary>
    if (column.EffectType is "EnumSelector" or "DictSelector") {
    @:[Dict(@(column.EffectType == "EnumSelector" ? $"nameof({column.DictTypeCode})" : literal(column.DictTypeCode)), AllowNullValue = true)]
    }
    if (column.WhetherRequired == "Y") {
    @:[Required(ErrorMessage = @literal(column.ColumnComment + "不能为空"))]
    }
    @:public virtual @nullable(column.NetType) @(column.PropertyName) { get; set; }
    @:
}
}

/// <summary>
/// @(comment(model.BusName))分页查询输入参数
/// </summary>
public class Page@(model.ClassName)Input : BasePageInput
{
@foreach (var column in model.QueryWhetherList) {
    @:/// <summary>
    @:/// @(comment(column.ColumnComment))
    @:/// </summary>
    if (column.QueryType == "isNotNull") {
    @:public bool? @(column.PropertyName) { get; set; }
    } else if (column.QueryType == "~") {
    @:public @(CodeGenTemplateSupport.NullableType(column.NetType))[] @(column.PropertyName)Range { get; set; }
    } else {
        if (column.EffectType is "EnumSelector" or "DictSelector") {
        @:[Dict(@(column.EffectType == "EnumSelector" ? $"nameof({column.DictTypeCode})" : literal(column.DictTypeCode)), AllowNullValue = true)]
        }
    @:public @nullable(column.NetType) @(column.PropertyName) { get; set; }
    }
    @:
}
@if (model.ImportFieldList.Count > 0) {
    @:/// <summary>
    @:/// 选中主键列表，兼容单主键导出
    @:/// </summary>
    @:public List<@(model.PrimaryKeyFieldList.First().NetType)> SelectKeyList { get; set; }
    @:
    @:/// <summary>
    @:/// 完整主键组合，用于组合主键导出
    @:/// </summary>
    @:public List<Delete@(model.ClassName)Input> SelectKeys { get; set; }
}
}

/// <summary>
/// @(comment(model.BusName))增加输入参数
/// </summary>
public class Add@(model.ClassName)Input
{
@foreach (var column in editable) {
    @:/// <summary>
    @:/// @(comment(column.ColumnComment))
    @:/// </summary>
    if (column.EffectType is "EnumSelector" or "DictSelector") {
    @:[Dict(@(column.EffectType == "EnumSelector" ? $"nameof({column.DictTypeCode})" : literal(column.DictTypeCode)), AllowNullValue = true)]
    }
    if (column.WhetherRequired == "Y" || (column.ColumnKey == "True" && column.PropertyName != "Id")) {
    @:[Required(ErrorMessage = @literal(column.ColumnComment + "不能为空"))]
    }
    if (column.NetType.TrimEnd('?') == "string" && column.ColumnLength > 0) {
    @:[MaxLength(@column.ColumnLength, ErrorMessage = @literal(column.ColumnComment + "字符长度不能超过" + column.ColumnLength))]
    }
    @:public @nullable(column.NetType) @(column.PropertyName) { get; set; }
    @:
}
}

/// <summary>
/// @(comment(model.BusName))删除输入参数
/// </summary>
public class Delete@(model.ClassName)Input
{
@foreach (var column in model.PrimaryKeyFieldList) {
    @:/// <summary>
    @:/// @(comment(column.ColumnComment))
    @:/// </summary>
    @:[Required(ErrorMessage = @literal(column.ColumnComment + "不能为空"))]
    @:public @nullable(column.NetType) @(column.PropertyName) { get; set; }
    @:
}
}

/// <summary>
/// @(comment(model.BusName))更新输入参数
/// </summary>
public class Update@(model.ClassName)Input
{
@foreach (var column in editable) {
    @:/// <summary>
    @:/// @(comment(column.ColumnComment))
    @:/// </summary>
    if (column.EffectType is "EnumSelector" or "DictSelector") {
    @:[Dict(@(column.EffectType == "EnumSelector" ? $"nameof({column.DictTypeCode})" : literal(column.DictTypeCode)), AllowNullValue = true)]
    }
    if (column.WhetherRequired == "Y" || column.ColumnKey == "True") {
    @:[Required(ErrorMessage = @literal(column.ColumnComment + "不能为空"))]
    }
    if (column.NetType.TrimEnd('?') == "string" && column.ColumnLength > 0) {
    @:[MaxLength(@column.ColumnLength, ErrorMessage = @literal(column.ColumnComment + "字符长度不能超过" + column.ColumnLength))]
    }
    @:public @nullable(column.NetType) @(column.PropertyName) { get; set; }
    @:
}
}

/// <summary>
/// @(comment(model.BusName))主键查询输入参数
/// </summary>
public class QueryById@(model.ClassName)Input : Delete@(model.ClassName)Input
{
}

@if (model.DropdownFieldList.Count > 0) {
@:/// <summary>
@:/// 下拉数据输入参数
@:/// </summary>
@:public class DropdownData@(model.ClassName)Input
@:{
    @:public bool FromPage { get; set; }
@:}
}
@if (model.HasSetStatus) {
@:/// <summary>
@:/// 设置状态输入参数
@:/// </summary>
@:public class Set@(model.ClassName)StatusInput : Delete@(model.ClassName)Input
@:{
    @:[Required(ErrorMessage = "状态不能为空")]
    @:public StatusEnum Status { get; set; }
@:}
}
@if (model.ImportFieldList.Count > 0) {
@:/// <summary>
@:/// @(comment(model.BusName))数据导入实体
@:/// </summary>
@:[ExcelImporter(SheetIndex = 1, IsOnlyErrorRows = true)]
@:public class Import@(model.ClassName)Input : BaseImportInput
@:{
    foreach (var column in model.ImportFieldList) {
        var headerName = (column.WhetherRequired == "Y" ? "*" : "") + column.ColumnComment;
        if (column.EffectType is "ForeignKey" or "ApiTreeSelector" or "DictSelector") {
        @:/// <summary>
        @:/// @(comment(column.ColumnComment))关联值
        @:/// </summary>
        @:[ImporterHeader(IsIgnore = true)]
        @:[ExporterHeader(IsIgnore = true)]
        @:public @nullable(column.NetType) @(column.PropertyName) { get; set; }
        @:
        @:/// <summary>
        @:/// @(comment(column.ColumnComment))文本
        @:/// </summary>
            if (column.EffectType == "DictSelector") {
            @:[Dict(@literal(column.DictTypeCode))]
            }
        @:[ImporterHeader(Name = @literal(headerName))]
        @:[ExporterHeader(@literal(headerName), Format = "@", Width = 25, IsBold = true)]
        @:public string @(column.ExtendedPropertyName) { get; set; }
        } else {
        @:/// <summary>
        @:/// @(comment(column.ColumnComment))
        @:/// </summary>
        @:[ImporterHeader(Name = @literal(headerName))]
        @:[ExporterHeader(@literal(headerName), Format = "@", Width = 25, IsBold = true)]
        @:public @nullable(column.NetType) @(column.PropertyName) { get; set; }
        }
        @:
    }
@:}
}
